/*
  ╔══════════════════════════════════════════════════════╗
  ║   En-têtes HTTP – ProjetBI V2 – projetbi.org         ║
  ║   Compatibles : Netlify, Cloudflare Pages            ║
  ╚══════════════════════════════════════════════════════╝

  Score cible : A+ Mozilla Observatory / securityheaders.com
*/

# ── Global ──────────────────────────────────────────────────────────────────
/*
  # Empêche l'intégration dans des iframes (anti-clickjacking)
  X-Frame-Options: DENY

  # Empêche le MIME sniffing
  X-Content-Type-Options: nosniff

  # HSTS – Force HTTPS pour 2 ans, inclut sous-domaines + preload list
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Politique de référent stricte
  Referrer-Policy: strict-origin-when-cross-origin

  # Isolation du contexte de navigation (Cross-Origin Isolation)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # Désactive les APIs sensibles non nécessaires
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Content Security Policy
  # - 'unsafe-inline' JS supprimé : on passe à des event-listeners en JS
  # - styles inline supprimés : toutes les règles sont dans style.css
  # - Supabase autorisé en connect-src uniquement
  Content-Security-Policy: default-src 'self'; script-src 'self' cdn.jsdelivr.net cdnjs.cloudflare.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com cdnjs.cloudflare.com; font-src 'self' fonts.gstatic.com cdnjs.cloudflare.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://jwsdxttjjbfnoufiidkd.supabase.co https://*.supabase.co static.cloudflareinsights.com; worker-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content;

  # Cache des assets statiques (1 an via versioning)
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

  # Masque la technologie serveur
  Server: -
  X-Powered-By: -

# ── Assets statiques – cache long terme ─────────────────────────────────────
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

# ── JSON Data – revalidation courte ─────────────────────────────────────────
/*.json
  Cache-Control: public, max-age=1800, stale-while-revalidate=3600

# ── Manifest & SW – pas de cache agressif ───────────────────────────────────
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: no-store, max-age=0

# ── Pages admin – jamais indexées, jamais cachées ───────────────────────────
/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate
  X-Frame-Options: DENY

/update_press_simple.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate

/kit-communication.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate
